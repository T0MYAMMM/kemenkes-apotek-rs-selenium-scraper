# Run Chrome without a visible window (true/false).
HEADLESS=false

# Optional explicit path to chromedriver. Leave empty to let Selenium Manager
# resolve a matching driver automatically.
CHROMEDRIVER_PATH=

# Optional Chrome extension (.crx) to load before scraping.
CHROME_EXTENSION_PATH=assets/extension_5_8_0_0.crx

# Directory where scraped CSV files are written.
OUTPUT_DIR=data/output

# Seconds to wait after a page load before interacting with it.
PAGE_LOAD_WAIT=10

# Maximum seconds to wait for an element to appear.
ELEMENT_TIMEOUT=10
